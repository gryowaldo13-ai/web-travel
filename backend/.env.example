# Environment Variables — Velora Travel Backend
# Copy this file to .env and fill in the values

# ─── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # production | development

# ─── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# ─── Admin WhatsApp ───────────────────────────────────────────
# Nomor WhatsApp Admin untuk menerima order (format: 62xxx)
WA_NUMBER=62895629466956

# ─── CARA 1: Email E-Tiket Otomatis (Nodemailer / SMTP) ───────
# Gunakan akun Gmail App Password atau SMTP provider lain
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=veloratravel@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Velora Travel <veloratravel@gmail.com>"

# ─── CARA 2: Bot WhatsApp Gateway Otomatis (Fonnte) ───────────
# Dapatkan token gratis di https://fonnte.com
FONNTE_TOKEN=your_fonnte_token_here
