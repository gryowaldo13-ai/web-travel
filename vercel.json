{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/src/index.html" },
    { "source": "/index.html", "destination": "/src/index.html" },
    { "source": "/order", "destination": "/src/order.html" },
    { "source": "/order.html", "destination": "/src/order.html" },
    { "source": "/tentang-kami", "destination": "/src/tentang kami.html" },
    { "source": "/tentang-kami.html", "destination": "/src/tentang kami.html" }
  ]
}
